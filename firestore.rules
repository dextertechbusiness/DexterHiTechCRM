rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'aryanshinde20302003@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().status == 'Active';
    }
    function isAdmin() {
      return isSuperAdmin() || (isActive() && userDoc().role == 'Admin');
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActive() || isSuperAdmin());
      allow list: if isActive() || isSuperAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == 'Pending'
            && request.resource.data.role == 'Member');
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
    match /admin_notifications/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /{col}/{id} {
      allow read, write: if (col in ['clients', 'tasks', 'requests', 'billing'])
                            && (isActive() || isSuperAdmin());
    }
  }
}

